# ==========================================
# APPLICATION
# ==========================================
APP_PORT=8080
APP_ENV=development # development | production
JWT_SECRET=ganti_dengan_secret_key_panjang_dan_acak_minimal_64_karakter

# ==========================================
# DATABASE (PostgreSQL / MySQL / SQLite)
# ==========================================
DB_DRIVER=postgres # postgres | mysql | sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=satu_sekolah
DB_SSLMODE=disable
SQLITE_DB_PATH=./satu_sekolah.db

# ==========================================
# CACHE (Redis / Database)
# ==========================================
CACHE_DRIVER=database # database | redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# TTL dalam detik untuk data cache
REDIS_TTL_SECONDS=300

# ==========================================
# WEB3 SECURITY - IMMUTABLE LEDGER
# PENTING: Kunci ini TIDAK BOLEH pernah diganti setelah production.
# Mengganti kunci ini akan membuat SELURUH chain hash ledger tidak valid.
# ==========================================
LEDGER_HMAC_SECRET=ganti_dengan_secret_key_ledger_yang_tidak_pernah_berubah_minimal_64_karakter

# ==========================================
# AWS CLOUD SERVICES
# ==========================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=satu-sekolah-assets

# Rekognition Collection ID (dibuat sekali via AWS CLI)
# Perintah: aws rekognition create-collection --collection-id satu-sekolah-faces
AWS_REKOGNITION_COLLECTION_ID=satu-sekolah-faces

# ==========================================
# AI - GOOGLE GEMINI
# ==========================================
GEMINI_API_KEY=ganti_dengan_gemini_api_key_anda
GEMINI_MODEL=gemini-2.5-flash

# Kuota token default untuk setiap tenant baru (2 Juta token)
AI_DEFAULT_TOKEN_LIMIT=2000000

# ==========================================
# PAYMENT GATEWAY - MIDTRANS
# ==========================================
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
# true = Sandbox (Testing), false = Production
MIDTRANS_IS_PRODUCTION=false

# Harga per 1 Juta Token (I/O) dalam USD (Dikonversi ke IDR saat checkout)
MIDTRANS_PRICE_PER_MILLION_TOKEN=10

# ==========================================
# SECURITY ENCRYPTION
# ==========================================
# APP_ENCRYPTION_KEY must be exactly 32 bytes (256-bit) for AES-256-GCM.
# Used for encrypting S3 URLs, Chats, PKL Journals, etc.
APP_ENCRYPTION_KEY=ganti_dengan_secret_key_panjang_sekali_minimal_32_karakter_ya_ini_32_byte