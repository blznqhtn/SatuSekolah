// ==========================================
// 23. WebTorrent Metadata
// ==========================================
Table torrent_metadata {
    file_path varchar(500) [pk]
    info_hash varchar(40) [not null]
    magnet_link text [not null]
    created_at timestamp [default: CURRENT_TIMESTAMP]
}

