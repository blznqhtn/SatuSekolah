}

Table "ai_module_settings" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "module_name" VARCHAR(50) [not null]
  "is_active" BOOLEAN [default: TRUE]
  "updated_at" TIMESTAMP

  Indexes {
    (tenant_id, module_name) [unique]
  }
}

Table "health_records" {
