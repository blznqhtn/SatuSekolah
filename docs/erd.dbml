Table "tenants" {
  "id" VARCHAR(36) [pk]
  "name" VARCHAR(255) [not null]
  "bank_code" VARCHAR(3) [unique, not null]
  "npsn" VARCHAR(50) [unique]
  "domain" VARCHAR(255) [unique]
  "address" TEXT
  "phone" VARCHAR(50)
  "email" VARCHAR(255)
  "logo_url" VARCHAR(255)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP
  "deleted_at" TIMESTAMP
}

Table "roles" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "name" VARCHAR(100) [not null]
  "is_custom" BOOLEAN [default: TRUE]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP
}

Table "permissions" {
  "id" VARCHAR(36) [pk]
  "name" VARCHAR(100) [unique, not null]
}

Table "role_permissions" {
  "role_id" VARCHAR(36)
  "permission_id" VARCHAR(36)

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table "majors" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "name" VARCHAR(100) [not null]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "deleted_at" TIMESTAMP
}

Table "classes" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "major_id" VARCHAR(36)
  "grade_level" INT
  "name" VARCHAR(100)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "deleted_at" TIMESTAMP
}

Table "users" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "class_id" VARCHAR(36)
  "account_number" VARCHAR(12) [unique, not null]
  "category" users_category_enum [not null]
  "status" users_status_enum [default: 'ACTIVE']
  "name" VARCHAR(255) [not null]
  "email" VARCHAR(255)
  "phone" VARCHAR(50)
  "password_hash" VARCHAR(255)
  "pin_hash" VARCHAR(255)
  "identifier" VARCHAR(100)
  "rfid_tag" VARCHAR(100) [unique]
  "face_encoding" TEXT
  "wallet_balance" DECIMAL(15,2) [default: 0]
  "public_key" TEXT
  "parent_id" VARCHAR(36)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP
  "deleted_at" TIMESTAMP

  Indexes {
    (tenant_id, email) [unique]
    (tenant_id, identifier) [name: "idx_users_tenant_identifier"]
    (tenant_id, class_id) [name: "idx_users_tenant_class"]
  }
}

Table "user_roles" {
  "user_id" VARCHAR(36)
  "role_id" VARCHAR(36)

  Indexes {
    (user_id, role_id) [pk]
  }
}

Table "payout_methods" {
  "id" VARCHAR(36) [pk]
  "user_id" VARCHAR(36)
  "provider_name" VARCHAR(100)
  "account_number" VARCHAR(100)
  "account_name" VARCHAR(255)
  "is_primary" BOOLEAN [default: FALSE]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP
}

Table "wallet_ledgers" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "user_id" VARCHAR(36)
  "transaction_type" wallet_ledgers_transaction_type_enum [not null]
  "amount" DECIMAL(15,2) [not null]
  "fee" DECIMAL(10,2) [default: 0]
  "reference_type" VARCHAR(100)
  "reference_id" VARCHAR(36)
  "previous_hash" VARCHAR(64) [not null]
  "current_hash" VARCHAR(64) [not null]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]

  Indexes {
    (tenant_id, user_id, created_at) [name: "idx_wallet_ledgers_user_date"]
  }
}

Table "attendance_settings" {
  "tenant_id" VARCHAR(36) [pk]
  "attendance_admin_staff_id" VARCHAR(36)
  "holiday_manager_role_id" VARCHAR(36)
  "student_check_in_time" TIME [default: '07:00:00']
  "student_check_out_time" TIME [default: '15:00:00']
  "student_tolerance_minutes" INT [default: 15]
  "staff_check_in_time" TIME [default: '07:30:00']
  "staff_check_out_time" TIME [default: '16:00:00']
  "staff_tolerance_minutes" INT [default: 10]
  "allow_rfid" BOOLEAN [default: TRUE]
  "allow_fingerprint" BOOLEAN [default: TRUE]
  "allow_face" BOOLEAN [default: TRUE]
  "face_match_threshold" DECIMAL(5,2) [default: 80.00]
  "updated_at" TIMESTAMP
  "updated_by" VARCHAR(36)
}

Table "holidays" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "name" VARCHAR(255) [not null]
  "date" DATE [not null]
  "applies_to" holidays_applies_to_enum [default: 'ALL']
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "created_by" VARCHAR(36)
}

Table "activities" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "name" VARCHAR(255) [not null]
  "is_mandatory" BOOLEAN [default: FALSE]
  "start_time" TIMESTAMP [not null]
  "end_time" TIMESTAMP [not null]
  "requires_checkout" BOOLEAN [default: FALSE]
  "replaces_daily_attendance" BOOLEAN [default: FALSE]
  "created_by" VARCHAR(36)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "activity_targets" {
  "id" VARCHAR(36) [pk]
  "activity_id" VARCHAR(36)
  "target_type" activity_targets_target_type_enum [not null]
  "target_id" VARCHAR(36) [not null]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "activity_attendances" {
  "id" VARCHAR(36) [pk]
  "activity_id" VARCHAR(36)
  "user_id" VARCHAR(36)
  "check_in_at" TIMESTAMP
  "check_out_at" TIMESTAMP
  "status" activity_attendances_status_enum [default: 'PRESENT']
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]

  Indexes {
    (activity_id, user_id) [unique]
  }
}

Table "attendances" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "user_id" VARCHAR(36)
  "type" VARCHAR(100)
  "method" VARCHAR(50)
  "check_in_at" TIMESTAMP
  "check_out_at" TIMESTAMP
  "status" attendances_status_enum
  "notes" TEXT

  Indexes {
    (tenant_id, user_id, check_in_at) [name: "idx_attendances_user_date"]
  }
}

Table "attendance_lates" {
  "id" VARCHAR(36) [pk]
  "attendance_id" VARCHAR(36)
  "reason" TEXT
  "submitted_at" TIMESTAMP
  "is_excused" BOOLEAN [default: FALSE]
  "reviewed_by" VARCHAR(36)
}

Table "user_violations" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "user_id" VARCHAR(36)
  "violation_type_id" VARCHAR(36)
  "points_applied" INT [not null]
  "evidence_url" VARCHAR(255)
  "notes" TEXT
  "recorded_by" VARCHAR(36)
  "parent_notified" BOOLEAN [default: FALSE]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "leave_requests" {
  "id" VARCHAR(36) [pk]
  "tenant_id" VARCHAR(36)
  "user_id" VARCHAR(36)
  "reason" TEXT
  "start_time" TIMESTAMP
  "end_time" TIMESTAMP
  "status" leave_requests_status_enum [default: 'PENDING']
  "current_tier" INT [default: 1]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP
}

Table "leave_approvals" {
  "id" VARCHAR(36) [pk]
  "leave_request_id" VARCHAR(36)
  "approver_role_id" VARCHAR(36)
  "tier_level" INT
  "status" leave_approvals_status_enum [default: 'PENDING']
  "approved_by" VARCHAR(36)
  "approved_at" TIMESTAMP
}

Table "ai_tenant_quotas" {
  "tenant_id" VARCHAR(36) [pk]
  "total_input_tokens" BIGINT [default: 1000000]
  "input_tokens_used" BIGINT [default: 0]
  "total_output_tokens" BIGINT [default: 1000000]
  "output_tokens_used" BIGINT [default: 0]
